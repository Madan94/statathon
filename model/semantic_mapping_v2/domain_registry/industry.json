{
  "usecase": "industry",
  "version": "2026.2",
  "description": "Industrial statistics and economic indicators (e.g. ASI, price indices, inflation). ASI blocks: E=characteristics, F=fixed assets, G=working capital, H=inputs, I=products manufactured, J=products sold.",
  "keywords": ["industry", "factory", "enterprise", "production", "output", "asi", "index", "inflation", "price", "wages", "capital", "value added", "economic", "blk", "block", "j1", "hi", "ah", "aj"],
  "domains": [
    {"domain": "enterprise", "description": "Establishment / factory identity and type. ASI Block A/E basic characteristics.", "synonyms": ["enterprise", "factory", "establishment", "unit", "firm", "organisation type", "blk", "block", "ae", "ye", "ye01", "ae01"], "examples": ["factory_id", "enterprise_type", "establishment", "unit_type", "yr", "blk", "ae01", "ye01", "ah01", "aj01"]},
    {"domain": "production", "description": "Output, products manufactured and quantities sold. ASI Block J (products sold: J11-J113).", "synonyms": ["production", "output", "products", "manufactured", "quantity produced", "production volume", "products sold", "j1", "j11", "j12", "j13", "j14", "j15", "j16", "j17", "j18", "j19", "j110", "j111", "j112", "j113"], "examples": ["production_volume", "output_quantity", "products_made", "j11", "j12", "j13", "j14", "j15", "j16", "j17", "j18", "j19", "j110", "j111", "j112", "j113"]},
    {"domain": "value_added", "description": "Gross/net value added and economic contribution.", "synonyms": ["value added", "gva", "net value added", "gross value added", "contribution"], "examples": ["gross_value_added", "net_value_added", "gva"]},
    {"domain": "capital", "description": "Fixed capital, investment and assets. ASI Block F.", "synonyms": ["capital", "fixed capital", "investment", "assets", "machinery", "plant", "block f", "f1", "fi", "hf"], "examples": ["fixed_capital", "invested_capital", "machinery_value", "f11", "f12", "f13"]},
    {"domain": "labor_cost", "description": "Wages, salaries and labour cost of the enterprise.", "synonyms": ["wages", "salary", "labour cost", "emoluments", "compensation", "bonus", "mandays", "workers"], "examples": ["total_wages", "salaries", "labour_cost", "emoluments"]},
    {"domain": "raw_materials", "description": "Inputs, raw materials and intermediate consumption. ASI Block H (HI1-HI7).", "synonyms": ["raw materials", "inputs", "intermediate consumption", "materials cost", "hi1", "hi2", "hi3", "hi4", "hi5", "hi6", "hi7", "block h", "input block", "material input"], "examples": ["raw_material_cost", "input_value", "materials_consumed", "hi1", "hi2", "hi3", "hi4", "hi5", "hi6", "hi7", "ah01"]},
    {"domain": "energy_input", "description": "Fuel and energy consumed by the enterprise.", "synonyms": ["fuel", "energy consumed", "electricity cost", "power input"], "examples": ["fuel_cost", "energy_consumed", "electricity_cost"]},
    {"domain": "price_index", "description": "Price indices such as WPI, CPI and base year indices.", "synonyms": ["price index", "wpi", "cpi", "index", "base year index", "index al", "index rl", "index_al", "index_rl"], "examples": ["index_al", "index_rl", "price_index", "wpi"]},
    {"domain": "inflation", "description": "Inflation rates and price change measures.", "synonyms": ["inflation", "inflation rate", "price change", "rate of inflation", "inflation_al", "inflation_rl"], "examples": ["inflation_al", "inflation_rl", "inflation_rate"]},
    {"domain": "indicator", "description": "Named economic indicator or measured series.", "synonyms": ["indicator", "measure", "series", "metric name"], "examples": ["indicator", "series_name", "measure"]},
    {"domain": "employment", "description": "Number of workers and persons engaged.", "synonyms": ["workers", "persons engaged", "employees", "workforce", "headcount", "mandays"], "examples": ["num_workers", "persons_engaged", "employees"]},
    {"domain": "industry_classification", "description": "Industry / sector classification (NIC, NIC code).", "synonyms": ["nic", "industry code", "sector", "industry division", "classification", "nic code", "nic 2008"], "examples": ["nic_code", "industry_code", "sector"]},
    {"domain": "geography", "description": "Geographic location: state, district, region.", "synonyms": ["state", "district", "region", "zone", "location"], "examples": ["state", "district", "region"]},
    {"domain": "survey_metadata", "description": "Reference period, base year, year, month, block identifier.", "synonyms": ["year", "base year", "month", "quarter", "reference period", "frequency", "yr", "blk", "block", "round"], "examples": ["year", "base_year", "month", "frequency", "yr", "blk"]},
    {"domain": "identifier", "description": "Unique enterprise / record identifiers.", "synonyms": ["id", "key", "code", "serial", "unit id"], "examples": ["unit_id", "record_id", "serial_no"]},
    {"domain": "uncorrelated", "description": "Free-text or values with no clear industrial domain.", "synonyms": ["remarks", "notes", "comment", "misc"], "examples": ["remarks", "notes", "comment"]}
  ]
}
