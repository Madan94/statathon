    {"domain": "insurance", "description": "Health insurance and coverage.", "synonyms": ["insurance", "coverage", "health scheme", "insured", "ayushman"], "examples": ["insurance_status", "coverage_type", "is_insured"]},
    {"domain": "medical_cost", "description": "Healthcare expenditure and out-of-pocket cost.", "synonyms": ["medical cost", "treatment cost", "expenditure", "out of pocket", "medical expense"], "examples": ["treatment_cost", "medical_expenditure", "oop_cost"]},
    {"domain": "healthcare_access", "description": "Access to healthcare: distance, availability, utilisation.", "synonyms": ["access", "distance to facility", "availability", "utilisation", "reachability"], "examples": ["distance_to_phc", "facility_access", "utilisation"]},
