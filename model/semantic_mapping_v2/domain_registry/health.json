    {"domain": "identifier", "description": "Unique patient / facility identifiers.", "synonyms": ["id", "key", "code", "patient id", "facility id"], "examples": ["patient_id", "facility_id", "record_id"]},
    {"domain": "uncorrelated", "description": "Free-text or values with no clear health domain.", "synonyms": ["remarks", "notes", "comment", "misc"], "examples": ["remarks", "notes", "comment"]}
