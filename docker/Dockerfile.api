# syntax=docker/dockerfile:1
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Set WORKDIR to /app so all absolute imports work from the repo root
# (template_engine, agents, report_builder, etc. are all under /app)
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel
# --prefer-binary: always pick pre-built wheels over source compilation.
# Prevents Cython/C++ compile failures (e.g. pandas on Python 3.13).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefer-binary -r /app/requirements.txt

COPY . /app

RUN ln -sfn /app/scripts /app/api/scripts

# Default CMD runs the API server.
# The pipeline service overrides this with:
#   command: ["python", "/app/scripts/run_pipeline.py"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
