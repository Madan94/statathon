FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip setuptools wheel
# --prefer-binary: always pick pre-built wheels over source compilation.
# Prevents Cython/C++ compile failures (e.g. pandas on Python 3.13).
RUN pip install --no-cache-dir --prefer-binary -r /app/requirements.txt

COPY . /app

RUN ln -sfn /app/scripts /app/api/scripts

WORKDIR /app/api

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
