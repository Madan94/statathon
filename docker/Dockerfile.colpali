# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# ColPali vision-PDF extractor (vidore/colpali-v1.2 default).
# Base image ships with PyTorch 2.4.1 + CUDA 12.1 + cuDNN 9 pre-installed.
#
# Build:  docker compose -f docker-compose.gpu.yml --profile gpu build colpali
# Run:    docker compose -f docker-compose.gpu.yml --profile gpu up colpali
#
# Cache strategy: BuildKit pip cache mount keeps wheels across builds.
# ─────────────────────────────────────────────────────────────────────────────
FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache \
    MODEL_ID=vidore/colpali-v1.2 \
    DEVICE=auto \
    COLPALI_DPI=120 \
    COLPALI_PAGE_BATCH_SIZE=1 \
    COLPALI_PORT=8001

WORKDIR /app

# ── Layer 1: System deps (poppler for pdf2image) ─────────────────────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils curl \
    && rm -rf /var/lib/apt/lists/*

# ── Layer 2: pip upgrade ─────────────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip

# ── Layer 3: ML libraries (torch already in base) ────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        "transformers>=4.40,<5" \
        "colpali-engine>=0.3,<1"

# ── Layer 4: Web/PDF utilities ───────────────────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        pdf2image \
        pdfplumber \
        fastapi \
        "uvicorn[standard]" \
        python-multipart

# ── Layer 5: Application code (invalidates only on code changes) ─────────────
COPY services/colpali/main.py /app/main.py

EXPOSE 8001

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${COLPALI_PORT:-8001}"]
