# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Fargate / ECS deployment image (no BuildKit cache mounts — immutable layers)
#
# DESIGN: Fail-fast + deterministic builds for production
#   - No --mount=type=cache (not available on Fargate build agents)
#   - PIP_NO_CACHE_DIR=1 for smaller image size
#   - Import verification before app code layer
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip setuptools wheel \
    && pip install --prefer-binary --no-cache-dir -r /app/requirements.txt

# ── Fail-fast: verify deps before adding app code ────────────────────────────
RUN python -c "\
import fastapi, uvicorn, pydantic; \
print(f'✓ fastapi={fastapi.__version__} pydantic={pydantic.__version__}')"

COPY . /app
RUN ln -sfn /app/scripts /app/api/scripts

WORKDIR /app/api
ENV PYTHONPATH=/app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
