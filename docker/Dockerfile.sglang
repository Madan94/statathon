# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# vLLM OpenAI-compatible LLM server (Qwen2.5-3B default).
# Replaces SGLang — sglang's sgl_kernel only ships SM100 (Blackwell) builds,
# which don't work on RTX 4050 (SM89 Ada Lovelace).
#
# vLLM advantages over sglang for our use case:
#   ✓ Proper SM89 support (RTX 40-series)
#   ✓ Same OpenAI API: /v1/chat/completions (drop-in replacement)
#   ✓ Smaller VRAM footprint for 3B models
#   ✓ Official Docker image tested on Ada Lovelace GPUs
#   ✓ No sgl_kernel dependency issues
#
# Build:  docker compose -f docker-compose.gpu.yml --profile gpu build sglang
# Run:    docker compose -f docker-compose.gpu.yml --profile gpu up sglang
#
# The service is still called "sglang" in compose to avoid changing all
# references in orchestrator/blueprint code. The API is identical.
# ─────────────────────────────────────────────────────────────────────────────
FROM vllm/vllm-openai:latest

ENV HF_HOME=/cache \
    VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ \
    VLLM_PORT=8002

# Install curl for healthcheck + ensure python alias exists
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && (which python || ln -sf $(which python3) /usr/local/bin/python) 2>/dev/null; true

# Entrypoint with diagnostics + VRAM-optimized flags
COPY docker/sglang-entrypoint.sh /app/entrypoint.sh
# Fix Windows CRLF → Linux LF (git on Windows adds \r which breaks #!/bin/bash)
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 8002

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=8 \
    CMD curl -fsS http://localhost:8002/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
