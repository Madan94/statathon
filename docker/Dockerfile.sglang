# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# SGLang LLM server for RTX 4050 Laptop (SM89, 6GB VRAM, 24GB RAM)
#
# ═══════════════════════════════════════════════════════════════════════════════
# STRATEGY: Use lmsysorg/sglang official image as base.
# This is the ONLY reliable way to get correctly compiled sgl_kernel for your
# GPU. Building from pip always has CUDA version / arch mismatches.
#
# The official image ships with:
#   - Correct sgl_kernel for your GPU arch
#   - PyTorch matched to container CUDA version
#   - All quantization kernels pre-compiled
#   - Tested server startup
#
# If the official image approach fails for any reason, there's a fallback
# strategy documented at the bottom (vLLM-based alternative).
# ═══════════════════════════════════════════════════════════════════════════════
#
# Build:  docker compose -f docker-compose.gpu.yml --profile gpu build sglang
# Run:    docker compose -f docker-compose.gpu.yml --profile gpu up sglang
# ─────────────────────────────────────────────────────────────────────────────
FROM lmsysorg/sglang:latest

# Override defaults for your 6GB VRAM laptop
ENV HF_HOME=/cache \
    SGLANG_MODEL=Qwen/Qwen2.5-3B-Instruct \
    SGLANG_PORT=8002 \
    SGLANG_MEM_FRACTION_STATIC=0.40

# Install curl for healthcheck (not in sglang image by default)
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Entrypoint with diagnostics
COPY docker/sglang-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8002

HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=8 \
    CMD curl -fsS http://localhost:8002/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
