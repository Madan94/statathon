  "glossary": {
    "LFPR": "Labour Force Participation Rate - percentage of the population in the labour force (working or seeking work).",
    "WPR": "Worker Population Ratio - percentage of employed persons in the population of age 15 years and above.",
    "UR": "Unemployment Rate - percentage of the labour force that is unemployed.",
    "PLFS": "Periodic Labour Force Survey - annual household survey conducted by NSO for employment/unemployment indicators.",
    "NSO": "National Statistical Office - apex statistical body under MoSPI, Government of India.",
    "MoSPI": "Ministry of Statistics and Programme Implementation - responsible for official statistics in India.",
    "CWS": "Current Weekly Status - activity status of a person during the reference week preceding the date of survey.",
    "Unemployment Rate": "Unemployment Rate (percent) - statistical indicator extracted from the source document.",
    "Worker Share": "Worker Share (percent) - statistical indicator extracted from the source document.",
    "Average Weekly Hours": "Average Weekly Hours (hours_per_week) - statistical indicator extracted from the source document.",
    "earnings": "Average Monthly Earnings (INR) - statistical indicator extracted from the source document.",
    "Employment Status": "Employment Status - statistical indicator extracted from the source document.",
    "Regular wage/salary employment": "Regular wage/salary employment (INR) - statistical indicator extracted from the source document.",
    "Gender": "Gender - classification dimension with categories: Male, Female, Persons.",
    "Sector": "Sector - classification dimension with categories: Rural, Urban.",
    "Age Group": "Age Group - classification dimension with categories: 15 years and above, 15-29 years, 15-59 years.",
    "Industry": "Industry - classification dimension with categories: Agriculture, Manufacturing, Construction, Services, Other.",
    "Activity Status": "Activity Status - classification dimension with categories: Usual Status (ps+ss), CWS."
  },
