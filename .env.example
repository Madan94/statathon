# ═══════════════════════════════════════════════════════════════════════════════
# BharatStat V3 — Environment Template
# Copy to .env and fill in real values.
# ═══════════════════════════════════════════════════════════════════════════════
#
# MODEL PROFILES (set MODEL_PROFILE to one of these):
#
#   openrouter_cheap_dev    — Qwen VLM + OpenRouter DeepSeek text (recommended)
#   qwen_groq_hybrid       — Qwen VLM + Groq text (free tier only)
#   local_first            — Qwen VLM + Ollama Gemma2:9b (zero cloud)
#   cloud_fallback_full    — full cascading fallback (most reliable)
#
# ═══════════════════════════════════════════════════════════════════════════════


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 1. MODEL PROFILE + RUNTIME GOVERNANCE                                       │
# └─────────────────────────────────────────────────────────────────────────────┘

MODEL_PROFILE=openrouter_cheap_dev

# Compiler V2 (E1-E12 extraction quality modules)
EXTRACTION_COMPILER_V2=true
EXTRACTION_COMPILER_STRICT=false

# Enrichment: OFF by default. Enable for final/high-quality runs only.
ENRICHMENT_ENABLED=false
ENRICHMENT_PROVIDER=openai
PROVIDER_SEMANTIC_ENRICHMENT=
PROVIDER_ENTITY_ENRICHMENT=
PROVIDER_QUESTION_REPAIR=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 2. API KEY POOL (10 slots)                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘
# Format: KEY_N_PROVIDER / KEY_N_VALUE / KEY_N_NAME / KEY_N_RPM / KEY_N_DAILY
# provider: openai | groq | gemini | qwen
# "openai" covers: OpenAI, OpenRouter, Together, DeepSeek, Ollama, LM Studio
#
# Logs: "[KEY_1:openrouter-deepseek] used for gap_fill (provider=openai)"

# Slot 1: OpenRouter (primary reasoning)
KEY_1_PROVIDER=openai
KEY_1_VALUE=sk-or-v1-YOUR_OPENROUTER_KEY
KEY_1_NAME=openrouter-deepseek
KEY_1_RPM=60
KEY_1_DAILY=

# Slots 2-9: Groq free-tier pool (8 keys for rotation)
KEY_2_PROVIDER=groq
KEY_2_VALUE=gsk_YOUR_GROQ_KEY_1
KEY_2_NAME=groq-1

KEY_3_PROVIDER=groq
KEY_3_VALUE=gsk_YOUR_GROQ_KEY_2
KEY_3_NAME=groq-2

# ... KEY_4 through KEY_9: more Groq keys for rate-limit rotation

# Slot 10: Local Qwen VLM (no real key needed)
KEY_10_PROVIDER=qwen
KEY_10_VALUE=local
KEY_10_NAME=local-docker-qwen
KEY_10_RPM=0
KEY_10_DAILY=

# Legacy fallback keys
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
HF_TOKEN=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 3. PROVIDER ROUTING                                                         │
# └─────────────────────────────────────────────────────────────────────────────┘
# Providers: qwen | openai | gemini | groq
# "openai" = any OpenAI-compatible server (OpenRouter, Ollama, LM Studio, vLLM)

# Global defaults
VLM_PROVIDER=qwen
REASONING_PROVIDER=openai

# Vision tasks: BLANK = uses VLM_PROVIDER (local Qwen, free)
PROVIDER_ENTITY_EXTRACTION=
PROVIDER_QUESTION_GENERATION=

# Text tasks: openai = OpenRouter DeepSeek (cheap, strong)
PROVIDER_ENTITY_BINDING=openai
PROVIDER_ENTITY_CLASSIFICATION=openai
PROVIDER_TOC_EXTRACTION=openai
PROVIDER_GAP_FILL=openai
PROVIDER_FACT_EXTRACTION=openai
PROVIDER_SEMANTIC_FALLBACK=openai

# Key slot assignments (blank = first matching provider key)
KEY_SLOT_ENTITY_EXTRACTION=
KEY_SLOT_QUESTION_GENERATION=
KEY_SLOT_ENTITY_BINDING=
KEY_SLOT_TOC_EXTRACTION=
KEY_SLOT_GAP_FILL=
KEY_SLOT_FACT_EXTRACTION=
KEY_SLOT_SEMANTIC_FALLBACK=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 4. OPENROUTER (via openai provider)                                         │
# └─────────────────────────────────────────────────────────────────────────────┘
# Point OPENAI_BASE_URL at OpenRouter. One key gives access to DeepSeek, Gemini,
# Claude, Llama, Mistral, etc. Model set via OPENAI_MODEL.
#
# For local Ollama instead: OPENAI_BASE_URL=http://localhost:11434/v1
#                           OPENAI_MODEL=gemma2:9b
#                           OPENAI_API_KEY=ollama

OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY
OPENAI_MODEL=deepseek/deepseek-chat-v3-0324
OPENAI_VISION_MODEL=google/gemini-flash-1.5
OPENAI_TIMEOUT=120


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 5. QWEN / SGLANG (local GPU vision)                                        │
# └─────────────────────────────────────────────────────────────────────────────┘
# docker compose -f docker-compose.gpu.yml up sglang
# Use 3B for 6GB VRAM, 7B for 12GB+

SGLANG_ENDPOINT=http://localhost:8002
SGLANG_MODEL=Qwen/Qwen2.5-VL-3B-Instruct-AWQ
SGLANG_TIMEOUT=300
SGLANG_TEMPERATURE=0.1
SGLANG_MAX_TOKENS=2048
SGLANG_DECOMPOSED=true
SGLANG_BACKEND=sglang
SGLANG_MEM_FRACTION=0.42

# Structured decoding (huge quality lever for 3B model)
GUIDED_JSON=1
GUIDED_JSON_BACKEND=outlines
SELF_CONSISTENCY=1
SELF_CONSISTENCY_THRESHOLD=0.6

# Qwen safety limits (enforced by R3 token budget manager)
QWEN_ENTITY_MAX_OUTPUT=192
QWEN_QUESTION_MAX_OUTPUT=384
QWEN_PROMPT_MAX_CHARS=2500
QWEN_IMAGE_MAX_DIM=800


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 6. GROQ (fallback pool)                                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_RPM=30


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 7. GEMINI (optional — OpenRouter provides Gemini access too)                │
# └─────────────────────────────────────────────────────────────────────────────┘

GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENRICHMENT=false


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 8. FALLBACK CHAINS                                                          │
# └─────────────────────────────────────────────────────────────────────────────┘

# Vision: Qwen local first, Groq vision if down
FALLBACK_ENTITY_EXTRACTION=qwen,groq
FALLBACK_QUESTION_GENERATION=qwen,groq

# Text: OpenRouter first, Groq fallback
FALLBACK_ENTITY_BINDING=openai,groq
FALLBACK_GAP_FILL=openai,groq
FALLBACK_FACT_EXTRACTION=openai,groq
FALLBACK_SEMANTIC_FALLBACK=openai,groq
FALLBACK_SEMANTIC_ENRICHMENT=openai,groq

# Behavior
ENABLE_TEXT_FALLBACK=true
ENABLE_VISION_FALLBACK=true
FALLBACK_ON_PARSE_ERROR=true
FALLBACK_ON_RATE_LIMIT=true
FALLBACK_ON_CONTEXT_OVERFLOW=false
FALLBACK_MAX_ATTEMPTS=2

# Legacy vision fallback order
VLM_FALLBACK_ORDER=qwen,groq,openai


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 9. TOKEN BUDGETS                                                            │
# └─────────────────────────────────────────────────────────────────────────────┘

ENTITY_EXTRACTION_MAX_TOKENS=256
ENTITY_EXTRACTION_TEMPERATURE=0.1

QUESTION_GENERATION_MAX_TOKENS=600
QUESTION_GENERATION_TEMPERATURE=0.15

ENTITY_BINDING_MAX_TOKENS=600
ENTITY_BINDING_TEMPERATURE=0.1

ENTITY_CLASSIFICATION_MAX_TOKENS=600
ENTITY_CLASSIFICATION_TEMPERATURE=0.1

TOC_EXTRACTION_MAX_TOKENS=800
TOC_EXTRACTION_TEMPERATURE=0.1

GAP_FILL_MAX_TOKENS=1200
GAP_FILL_TEMPERATURE=0.2

FACT_EXTRACTION_MAX_TOKENS=1200
FACT_EXTRACTION_TEMPERATURE=0.15

SEMANTIC_FALLBACK_MAX_TOKENS=1500
SEMANTIC_FALLBACK_TEMPERATURE=0.2


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 10. LOCAL SERVICES                                                          │
# └─────────────────────────────────────────────────────────────────────────────┘

LAYOUTLM_ENDPOINT=http://localhost:8001
LAYOUTLM_TIMEOUT=300
LAYOUTLM_PORT=8001
LAYOUTLM_MODEL_ID=Kwan0/layoutlmv3-base-finetune-DocLayNet-100k

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 11. CACHE / CHECKPOINTING                                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

CHECKPOINT_ENABLED=true
CHECKPOINT_MODE=fresh
CHECKPOINT_PIPELINE_VERSION=extraction_gold_v2_openrouter
CHECKPOINT_STRICT_VERSION=true
CHECKPOINT_NAMESPACE=dev
CHECKPOINT_DIR=./checkpoints
REDIS_URL=redis://localhost:6379/0
REDIS_CHECKPOINT_PREFIX=ckpt
REDIS_CHECKPOINT_TTL_HOURS=168
REDIS_CHECKPOINT_TTL_LLM_HOURS=24


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 12. DATABASE & STORAGE                                                      │
# └─────────────────────────────────────────────────────────────────────────────┘

DATABASE_URL=postgresql://user:password@host:6543/dbname
DB_NULL_POOL=true
DB_POOL_SIZE=2
DB_POOL_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
IMMUTABLE_VAULT_REQUIRED=true

REPORT_STORAGE_PATH=./storage/reports
UPLOAD_STORAGE_PATH=./storage/uploads
REPORT_TEMPLATE_DIR=./storage/templates
HUGGINGFACE_HUB_CACHE=./model/cache
OUTPUT_DIR=./outputs


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 13. APP / AUTH                                                              │
# └─────────────────────────────────────────────────────────────────────────────┘

SECRET_KEY=change-me-at-least-64-chars
APP_ENV=development
AUTH_REQUIRED=true

DEV_AUTH_ENABLED=true
DEV_TEST_EMAIL=officer@example.com
DEV_TEST_PASSWORD=TestOfficer123!
DEV_TEST_OTP=123456

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

NEXT_PUBLIC_API_URL=http://localhost:8000


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 14. EMAIL                                                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

MAIL_INTERNAL_SECRET=change-me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BharatStat <noreply@example.com>


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 15. EXTRACTION QUALITY                                                      │
# └─────────────────────────────────────────────────────────────────────────────┘

EXTRACTION_PIPELINE=v2
PDF_DPI=150
VLM_MAX_IMAGE_DIM=800
POPPLER_PATH=
TESSERACT_CMD=

ENTITY_MIN_LENGTH=4
ENTITY_MAX_LENGTH=80
ENTITY_FUZZY_MATCH_THRESHOLD=0.70
ENTITY_SIMILARITY_THRESHOLD=0.85
INFERENCE_CONFIDENCE_THRESHOLD=0.30
REVIEW_MIN_TOPICS=2
REVIEW_MIN_QUESTIONS=3
REVIEW_MIN_ENTITIES=5
REVIEW_MIN_CONFIDENCE=0.4

PIB_ENTITY_CAP=25
STAT_ENTITY_CAP=80
STAT_TABLE_CAP=30
STAT_Q_PER_CHAPTER=3
MAX_CHAPTERS_LOOP1=20


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 16. AGENT ROLES (report generation)                                         │
# └─────────────────────────────────────────────────────────────────────────────┘
# All agents use OpenRouter DeepSeek via openai provider.
# Change to groq or gemini if preferred.

DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=deepseek/deepseek-chat-v3-0324

SCRIBE_PROVIDER=openai
SCRIBE_MODEL=deepseek/deepseek-chat-v3-0324

INFERRER_PROVIDER=openai
INFERRER_MODEL=deepseek/deepseek-chat-v3-0324

VERIFIER_PROVIDER=openai
VERIFIER_MODEL=deepseek/deepseek-chat-v3-0324

PLANNER_PROVIDER=openai
PLANNER_MODEL=deepseek/deepseek-chat-v3-0324

ENRICHER_PROVIDER=openai
ENRICHER_MODEL=deepseek/deepseek-chat-v3-0324

GEMINI_RPM=60


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │ 17. OFFLINE / AIR-GAPPED MODE                                               │
# └─────────────────────────────────────────────────────────────────────────────┘

# LLM_DISABLED=1 skips ALL LLM/VLM calls (fully deterministic offline)
LLM_DISABLED=

# EXTRACTION_EMIT_LEGACY=1 also writes legacy enterprise_ast.json
EXTRACTION_EMIT_LEGACY=

LOG_LEVEL=INFO
