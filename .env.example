SECRET_KEY=change-me-use-long-random-string-min-32-chars-required-for-production

# Authentication (BharatStat officer signup + email OTP)
AUTH_REQUIRED=true
ALLOW_LEGACY_ANON_USER=false
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
COOKIE_SECURE=false
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
CSRF_ENABLED=true
APP_ENV=development
NEXT_INTERNAL_URL=http://localhost:3000
MAIL_INTERNAL_SECRET=dev-mail-secret-change-me
AUTH_RATE_MAX_PER_WINDOW=20

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
UPLOAD_STORAGE_PATH=./storage/uploads
REPORT_STORAGE_PATH=./storage/reports
REDIS_URL=redis://localhost:6379/0
HUGGINGFACE_API_KEY=
HUGGINGFACE_HUB_CACHE=./model/cache
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
AWS_REGION=auto
S3_UPLOAD_PREFIX=datasets
PRESIGNED_UPLOAD_EXPIRES_SECONDS=3600
REGISTER_SIZE_TOLERANCE_BYTES=8
OBJECT_STORAGE_DISABLED=
STATATHON_CLUSTERING=hierarchical
STATATHON_SMALL_DATASET_MAX_COLS=24
STATATHON_LINKAGE_SIMILARITY=0.45
STATATHON_LINKAGE_SIMILARITY_SMALL=0.58
STATATHON_LINKAGE_SIMILARITY_CAP=0.88
STATATHON_SKIP_CLUSTER_MERGE_SMALL=true
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# CORS (dashboard)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Derived datasets after user applies decisions
DERIVED_STORAGE_PATH=./storage/derived

# Optional Google OAuth (SSO)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/google/callback
# OAUTH_FRONTEND_REDIRECT=http://localhost:3000/login