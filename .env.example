# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# PHOENIX_ENDPOINT=http://localhost:6006
TRACING_ENABLED=0

# === Checkpointing ===
CHECKPOINT_ENABLED=false
# CHECKPOINT_DIR=./checkpoints

# === GPU Pipeline (docker-compose.gpu.yml) ===
