SCRIBE_API_KEY=gsk_...
SCRIBE_MODEL=llama-3.1-70b-versatile

INFERRER_PROVIDER=gemini
INFERRER_API_KEY=AI...
INFERRER_MODEL=gemini-2.5-flash

VERIFIER_PROVIDER=groq
VERIFIER_API_KEY=gsk_...
VERIFIER_MODEL=llama-3.1-8b-instant

PLANNER_PROVIDER=groq
PLANNER_API_KEY=gsk_...
PLANNER_MODEL=llama-3.1-8b-instant

ENRICHER_PROVIDER=gemini
ENRICHER_API_KEY=AI...
ENRICHER_MODEL=gemini-2.5-flash

# === Global Fallback ===
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_API_KEY=gsk_...
DEFAULT_LLM_MODEL=llama-3.1-8b-instant

# === Rate Limits ===
GROQ_RPM=30
GEMINI_RPM=60

# === Services ===
# ColPali: when running locally (non-Docker), use port 8001
# When running via docker-compose.gpu.yml, this is set automatically
COLPALI_ENDPOINT=http://localhost:8001
# SGLang: port 8002 (matches docker-compose.gpu.yml)
SGLANG_ENDPOINT=http://localhost:8002
SGLANG_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ

# === Storage ===
DATABASE_URL=postgresql://...
QDRANT_URL=https://xxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=...
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Observability (opt-in) ===
