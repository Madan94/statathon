# --- API / database ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# or local: sqlite:///./statathon.db

# --- Local multipart uploads (existing /datasets/upload) ---
UPLOAD_STORAGE_PATH=./storage/uploads
REPORT_STORAGE_PATH=./storage/reports

# --- S3-compatible presigned uploads (R2 / AWS S3 / MinIO) ---
# Set these to enable POST /datasets/upload-url and /datasets/register.
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS S3: leave empty. R2/MinIO: set full endpoint, e.g.
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
AWS_REGION=auto
S3_UPLOAD_PREFIX=datasets
PRESIGNED_UPLOAD_EXPIRES_SECONDS=3600
REGISTER_SIZE_TOLERANCE_BYTES=8
OBJECT_STORAGE_DISABLED=

# Optional comma list to override allowed Content-Types for upload-url
# DATASET_UPLOAD_ALLOWED_CONTENT_TYPES=text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
