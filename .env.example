# =============================================================================
# STATATHON — copy to `.env` and fill values (never commit real `.env`).
# Loads from repo root (see api/database/database.py).
#
# Step-by-step for every variable below (especially Gemini / Neo4j / R2):
#   docs/ENV_SETUP_STEP_BY_STEP.md
# =============================================================================

# --- JWT / auth (API) ---
SECRET_KEY=change-me-use-long-random-string

# --- Primary database ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local dev fallback:
# DATABASE_URL=sqlite:///./statathon.db

# --- Local multipart uploads ---
UPLOAD_STORAGE_PATH=./storage/uploads
REPORT_STORAGE_PATH=./storage/reports

# --- Celery / async (optional) ---
REDIS_URL=redis://localhost:6379/0

# --- HuggingFace (optional; transformer / hub cache) ---
HUGGINGFACE_API_KEY=
# Directory created on startup when unset defaults to ./model/cache; HF_HOME is set here by the API/pipeline bootstrap.
HUGGINGFACE_HUB_CACHE=./model/cache

# --- OpenAI (optional integrations) ---
OPENAI_API_KEY=

# --- Gemini — optional ambiguity refinement (only when scores are tied) ---
# Used by services/gemini_semantic_fallback.py
GEMINI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_SEMANTIC_MODEL=gemini-1.5-flash

# =============================================================================
# S3-compatible storage (R2 / AWS / MinIO) — presigned upload flow
# =============================================================================
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
AWS_REGION=auto
S3_UPLOAD_PREFIX=datasets
PRESIGNED_UPLOAD_EXPIRES_SECONDS=3600
REGISTER_SIZE_TOLERANCE_BYTES=8
OBJECT_STORAGE_DISABLED=

# Optional: override allowed MIME types for presigned uploads
# DATASET_UPLOAD_ALLOWED_CONTENT_TYPES=text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# =============================================================================
# Semantic intelligence pipeline
# =============================================================================
# hierarchical (default) | hdbscan (pip install hdbscan)
STATATHON_CLUSTERING=hierarchical

# =============================================================================
# Neo4j — optional live knowledge-graph sync after each analysis
# =============================================================================
# When NEO4J_ENABLED=true and password set, subgraph is UPSERT-scoped per analysis_id.
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
