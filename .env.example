# ═══════════════════════════════════════════════════════════════════════════════
# BharatStat V2 — Environment Template
# Copy to .env and fill in real values. Every variable in the codebase is listed
# here. This file is the single source of truth for configuration.
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. App / Auth ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-at-least-64-chars
APP_ENV=development
AUTH_REQUIRED=true
DEV_AUTH_ENABLED=true
DEV_TEST_EMAIL=officer@example.com
DEV_TEST_PASSWORD=TestOfficer123!
DEV_TEST_OTP=123456
COOKIE_SECURE=false
CSRF_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_RATE_MAX_PER_WINDOW=20
ALLOW_LEGACY_ANON_USER=false


# ── 2. Database & Storage ──────────────────────────────────────────────────────
# Pick ONE database profile (see docs/deploy/aws/08-rds-mumbai-staging.md):
#
# PROFILE A — Local dev (fastest; recommended for daily laptop work):
#   docker run -d --name statathon-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=statathon -p 5432:5432 postgres:16
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/statathon
#   DB_POOL_SIZE=10
#   DB_POOL_MAX_OVERFLOW=20
#   DB_STATEMENT_TIMEOUT_MS=15000
#
# PROFILE B — RDS Mumbai staging (shared team DB via SSM tunnel; copy .env.rds-staging.example):
#   DATABASE_URL=postgresql://statathon:PASSWORD@127.0.0.1:5433/statathon?sslmode=require
#   DB_POOL_SIZE=5
#   DB_POOL_MAX_OVERFLOW=10
#   DB_STATEMENT_TIMEOUT_MS=30000
#
# PROFILE C — Production ECS (private RDS in same VPC; set via Secrets Manager):
#   DATABASE_URL=postgresql://user:pass@rds-endpoint.ap-south-1.rds.amazonaws.com:5432/statathon?sslmode=require
#   AWS_REGION=ap-south-1  (must match RDS + S3 + ECS — see 09-ap-south-1-colocation.md)
#
# Legacy providers (not recommended for dev speed):
#   Xata: postgresql://WORKSPACE_ID:API_KEY@REGION.sql.xata.sh:5432/DATABASE:BRANCH?sslmode=require
#   Supabase/Neon: postgresql://user:password@host/dbname?sslmode=require
#
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/statathon
DB_STATEMENT_TIMEOUT_MS=15000
DB_NULL_POOL=false
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_POOL_RECYCLE=280
DB_CONNECT_TIMEOUT=10
DB_POOL_TIMEOUT=30
REDIS_URL=redis://localhost:6379/0
HUGGINGFACE_HUB_CACHE=./model/cache
REPORT_STORAGE_PATH=./storage/reports
UPLOAD_STORAGE_PATH=./storage/uploads
REPORT_TEMPLATE_DIR=./storage/templates
DERIVED_STORAGE_PATH=./storage/derived

STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_UPLOAD_PREFIX=datasets
S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:ACCOUNT:key/KEY-ID
S3_VAULT_KMS_KEY_ID=
S3_VAULT_PREFIX=report_templates/immutable
OBJECT_STORAGE_DISABLED=
PRESIGNED_UPLOAD_EXPIRES_SECONDS=3600
REGISTER_SIZE_TOLERANCE_BYTES=8
IMMUTABLE_VAULT_REQUIRED=true

QDRANT_URL=
QDRANT_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ── 3. Email / SMTP ────────────────────────────────────────────────────────────
MAIL_INTERNAL_SECRET=dev-mail-secret-change-me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BharatStat <noreply@example.com>
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_INTERNAL_URL=http://localhost:3000


# ── 4. Model Providers — API Keys ─────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_KEY=


# ── 5. Model Selection ────────────────────────────────────────────────────────
# These are the ONLY places model names should exist. Never hardcode in Python.

# Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEMANTIC_MODEL=gemini-2.5-flash

# Groq
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# OpenAI-compatible (covers OpenAI, OpenRouter, Together, DeepSeek, Ollama, LM Studio).
# Point OPENAI_BASE_URL at the server; OPENAI_API_KEY is only needed for api.openai.com.
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1  OPENAI_MODEL=deepseek/deepseek-chat
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1     OPENAI_MODEL=qwen2.5:7b   (no key)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120

# Qwen (served by SGLang — use 3B for 6GB VRAM, 7B for 12GB+)
SGLANG_MODEL=Qwen/Qwen2.5-VL-3B-Instruct-AWQ
# SGLANG_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# Global fallback
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Per-role LLM (provider: gemini | groq | qwen | openai)
SCRIBE_PROVIDER=gemini
SCRIBE_API_KEY=
SCRIBE_MODEL=gemini-2.5-flash

INFERRER_PROVIDER=gemini
INFERRER_API_KEY=
INFERRER_MODEL=gemini-2.5-flash

VERIFIER_PROVIDER=gemini
VERIFIER_API_KEY=
VERIFIER_MODEL=gemini-2.5-flash

PLANNER_PROVIDER=gemini
PLANNER_API_KEY=
PLANNER_MODEL=gemini-2.5-flash

ENRICHER_PROVIDER=gemini
ENRICHER_API_KEY=
ENRICHER_MODEL=gemini-2.5-flash

GEMINI_RPM=60
GROQ_RPM=30


# ── 6. Pipeline Extraction — Global Model Routing ─────────────────────────────
# Switch ALL vision tasks:   VLM_PROVIDER=gemini
# Switch ALL text/reasoning: REASONING_PROVIDER=gemini
# Mix: VLM_PROVIDER=qwen REASONING_PROVIDER=gemini  (recommended — Gemini for reasoning only)
# Values: qwen | gemini | groq | openai   (openai also covers OpenRouter/Ollama/LM Studio)

VLM_PROVIDER=qwen
REASONING_PROVIDER=qwen
VLM_MAX_CONSECUTIVE_FAIL=3

# ── 6b. Offline / Air-Gapped Mode ─────────────────────────────────────────────
# LLM_DISABLED=1 skips EVERY LLM/VLM call (no API key, no Qwen, no Gemini needed).
# The pipeline then runs fully deterministically on pdfplumber + programmatic
# fallbacks (LayoutLM also auto-degrades to pdfplumber when its server is down).
# Use for: air-gapped deploys, GPU-less CI, and reproducible offline simulations.
# Leave blank for normal (online) operation.
LLM_DISABLED=

# EXTRACTION_EMIT_LEGACY=1 ALSO writes the legacy blended enterprise_ast.json +
# blueprint.json alongside the canonical value-free template.ast.json +
# template.blueprint.json. Default OFF (only the 3-file value-free model is emitted).
EXTRACTION_EMIT_LEGACY=


# ── 7. Pipeline Extraction — Per-Task Provider Overrides ──────────────────────
# Leave blank to use VLM_PROVIDER / REASONING_PROVIDER global above.
# Set to: gemini | groq | qwen | openai

PROVIDER_ENTITY_EXTRACTION=
PROVIDER_QUESTION_GENERATION=
PROVIDER_ENTITY_BINDING=
PROVIDER_TOC_EXTRACTION=
PROVIDER_GAP_FILL=
PROVIDER_FACT_EXTRACTION=
PROVIDER_SEMANTIC_FALLBACK=


# ── 8. Qwen / SGLang Service ──────────────────────────────────────────────────
SGLANG_ENDPOINT=http://localhost:8002
SGLANG_TIMEOUT=300
SGLANG_TEMPERATURE=0.1
SGLANG_MAX_TOKENS=2048
SGLANG_DECOMPOSED=true
SGLANG_BACKEND=sglang
SGLANG_MEM_FRACTION=0.42


# ── 8b. Max-Qwen Hardening (structured decoding + self-consistency) ────────────
# GUIDED_JSON: send vLLM guided_json schema-constrained decoding on qwen calls
#   (huge quality lever for the 3B model). Default ON; set 0 for backends without it.
GUIDED_JSON=1
GUIDED_JSON_BACKEND=outlines
# SELF_CONSISTENCY: confidence-gated 2-pass re-sampling. Only re-samples when the
#   first pass self-reports confidence < threshold (cheap because max-num-seqs=1).
SELF_CONSISTENCY=1
SELF_CONSISTENCY_THRESHOLD=0.6


# ── 9. LayoutLM Service ───────────────────────────────────────────────────────
LAYOUTLM_ENDPOINT=http://localhost:8001
LAYOUTLM_TIMEOUT=300


# ── 10. PDF & Image Processing ────────────────────────────────────────────────
EXTRACTION_PIPELINE=v2
PDF_DPI=150
VLM_MAX_IMAGE_DIM=800
POPPLER_PATH=
TESSERACT_CMD=


# ── 11. LLM Call Parameters (tokens & temperature per task) ──────────────────
ENTITY_EXTRACTION_MAX_TOKENS=256
ENTITY_EXTRACTION_TEMPERATURE=0.1

QUESTION_GENERATION_MAX_TOKENS=600
QUESTION_GENERATION_TEMPERATURE=0.15

ENTITY_BINDING_MAX_TOKENS=384
ENTITY_BINDING_TEMPERATURE=0.1

TOC_EXTRACTION_MAX_TOKENS=1000
TOC_EXTRACTION_TEMPERATURE=0.1

GAP_FILL_MAX_TOKENS=1000
GAP_FILL_TEMPERATURE=0.2

FACT_EXTRACTION_MAX_TOKENS=1200
FACT_EXTRACTION_TEMPERATURE=0.15

SEMANTIC_FALLBACK_MAX_TOKENS=2000
SEMANTIC_FALLBACK_TEMPERATURE=0.2

ENTITY_CLASSIFICATION_MAX_TOKENS=600
ENTITY_CLASSIFICATION_TEMPERATURE=0.1


# ── 12. Quality Thresholds ────────────────────────────────────────────────────
ENTITY_MIN_LENGTH=4
ENTITY_MAX_LENGTH=80
ENTITY_FUZZY_MATCH_THRESHOLD=0.70
CHAPTER_MIN_WORDS=2
CHAPTER_MIN_CHARS=8
HEADING_THRESHOLD_PT=1.5
H1_THRESHOLD_PT=3.0
CONTEXT_SCRIPT_MAX_CHARS=600
SECTION_SUMMARY_MAX_CHARS=600
ENTITY_SUMMARY_MAX_CHARS=300
GEMINI_COVERAGE_THRESHOLD=0.5
INFERENCE_CONFIDENCE_THRESHOLD=0.30
INFERENCE_VLM_MIN_CONF=0.85
INFERENCE_PATTERN_MIN_CONF=0.65
INFERENCE_HYBRID_MIN_CONF=0.60
INFERENCE_STUB_CONF=0.30


# ── 13. Document Type Caps ────────────────────────────────────────────────────
PIB_ENTITY_CAP=25
PIB_TABLE_CAP=0
PIB_Q_PER_CHAPTER=2
STAT_ENTITY_CAP=80
STAT_TABLE_CAP=30
STAT_Q_PER_CHAPTER=3
MAX_PATTERNS_PER_CHAPTER=5
MAX_CHAPTERS_LOOP1=20


# ── 14. GPU / Docker Orchestration ────────────────────────────────────────────
PIPELINE_GPU_MODE=sequential
GPU_COMPOSE_FILE=./docker-compose.gpu.yml
GPU_HOST=127.0.0.1
COLPALI_ENDPOINT=http://localhost:8001
COLPALI_TIMEOUT=600
COLPALI_WARMUP_TIMEOUT=180
SGLANG_WARMUP_TIMEOUT=240


# ── 15. Neo4j ─────────────────────────────────────────────────────────────────
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mospi_secure_password
NEO4J_DATABASE=neo4j


# ── 16. Observability & Checkpointing ─────────────────────────────────────────
TRACING_ENABLED=0
LTM_ENABLED=0
CHECKPOINT_ENABLED=true
CHECKPOINT_DIR=./checkpoints
CHECKPOINT_BACKEND=auto
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=


# ── 17. Template Engine Thresholds ────────────────────────────────────────────
ENTITY_SIMILARITY_THRESHOLD=0.85
ENTITY_CONFIDENCE_BOOST=0.05
ENTITY_MAX_BOOST=0.15
REVIEW_MIN_TOPICS=2
REVIEW_MIN_QUESTIONS=3
REVIEW_MIN_ENTITIES=5
REVIEW_MIN_CONFIDENCE=0.4
VERIFIER_DEFAULT_TOLERANCE=0.05
VERIFIER_DOMAIN_TOLERANCE_PATH=
STATATHON_CLUSTERING=hierarchical
STATATHON_SMALL_DATASET_MAX_COLS=24
STATATHON_LINKAGE_SIMILARITY=0.45
STATATHON_LINKAGE_SIMILARITY_SMALL=0.58
STATATHON_LINKAGE_SIMILARITY_CAP=0.88
STATATHON_SKIP_CLUSTER_MERGE_SMALL=true
STATATHON_HDBSCAN_MIN_CLUSTER_SMALL=3


# ── 18. Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000


# ── 19. V1 Legacy (ColPali — not used when EXTRACTION_PIPELINE=v2) ────────────
VLM_BACKEND=colpali
PDF_PARSER=colpali
COLPALI_MODEL=vidore/colpali-v1.2
COLPALI_DPI=96
COLPALI_PAGE_BATCH_SIZE=1
COLPALI_TORCH_DTYPE=float16
COLPALI_IN_PROCESS=false
COLPALI_ALLOW_SIDECAR=true
