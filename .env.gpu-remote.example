# Copy these into .env when using AWS GPU EC2 for ColPali + SGLang.
# GPU_HOST = EC2 public IP, or 127.0.0.1 when using SSM port forwarding.

GPU_HOST=127.0.0.1

VLM_BACKEND=colpali
PDF_PARSER=colpali
COLPALI_ENDPOINT=http://127.0.0.1:8100/extract
COLPALI_IN_PROCESS=false
COLPALI_ALLOW_SIDECAR=true
COLPALI_TIMEOUT=600

SGLANG_BACKEND=sglang
SGLANG_ENDPOINT=http://127.0.0.1:30000
SGLANG_MODEL=Qwen/Qwen2.5-3B-Instruct
SGLANG_TIMEOUT=300
SGLANG_DECOMPOSED=true

# On EC2 only:
# GPU_MODEL_CACHE=/data/model/cache
# HF_TOKEN=
