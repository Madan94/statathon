  "pipeline_quality_matrix": {
    "description": "Score card for comparing actual output vs this gold standard",
    "scoring": {
      "entity_precision": {
        "formula": "len(good_entities) / len(total_entities)",
        "target": ">= 0.60",
        "good_entity": "entity.name not in FORBIDDEN_NAMES AND entity.entityType in ['measure','dimension','filter','metadata']"
      },
      "topic_recall": {
        "formula": "len(matched_topics) / len(gold_topics)",
        "target": ">= 0.75",
        "match_criteria": "fuzzy match of title with gold topic titles"
      },
      "question_quality": {
        "formula": "len(non_placeholder_questions) / len(total_questions)",
        "target": ">= 0.80",
        "placeholder_pattern": "intent == 'Specific analytical question referencing real entities?' OR questionType contains '|'"
      },
      "fact_coverage": {
        "formula": "len(facts_with_required_values) / len(required_numeric_values)",
        "target": ">= 0.70"
      }
    }
  }
