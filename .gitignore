# HuggingFace / transformers model downloads (can appear anywhere in the tree)
# Large model weight files — never commit
*.safetensors
*.bin
*.ot
*.pt
*.onnx
*.h5
*.msgpack

# HuggingFace hub cache structure (blobs, refs, snapshots dirs)
**/hub/
**/blobs/
**/refs/
**/snapshots/

# HF lock files (download-in-progress markers)
*.lock
**/*.lock

# HF config/tokenizer JSON that appears inside cache snapshots
# (We keep OUR JSON configs tracked, but HF downloads into hub/models--*/snapshots/*)
**/models--*/

# Jinja templates downloaded by transformers tokenizers
*.jinja
**/*.jinja

# Logs from model loading
*.log
**/*.log

# Downloaded tokenizer/vocab files (large, not ours)
**/vocab.json
**/merges.txt
**/tokenizer.json
**/tokenizer_config.json
**/preprocessor_config.json
**/generation_config.json
**/special_tokens_map.json
.venv/
data/raw_uploads

# Running uvicorn from `api/` drops caches/logs here — do not commit
api/audit_log.json
api/model/
api/storage/

# Report Builder runtime artifacts (generated PDFs, uploaded templates, KG exports)
storage/reports/
storage/templates/
storage/derived/
storage/uploads/

# Extraction pipeline generated outputs (template.ast.json, rendered PDFs, filled ASTs)


