    {
      "entityId": "ent_gender",
      "canonicalName": "Gender",
      "entityType": "dimension",
      "aliases": ["Gender", "Sex", "Male/Female"],
      "valueDomain": { "kind": "categorical", "members": ["Male", "Female", "Transgender"], "allowOther": true },
      "cardinalityHint": "low",
      "scope": "classifier",
      "confidence": null
    },
    {
      "entityId": "ent_state",
      "canonicalName": "State/UT",
      "entityType": "dimension",
      "aliases": ["State", "State/UT", "State or UT", "region"],
