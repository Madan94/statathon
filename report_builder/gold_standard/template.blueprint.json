  "topics": [
    {
      "topicId": "topic_wpr",
      "title": "Worker Population Ratio",
      "order": 1,
      "semanticRef": "sec_wpr",
      "questions": [
        {
          "questionId": "q_wpr_01",
          "intent": "Compare Worker Population Ratio across sector (Rural vs Urban) for the current period.",
          "questionType": "comparison",
          "priority": 1,
          "requiredEntities": [
            { "entityId": "ent_wpr", "role": "measure", "required": true },
            { "entityId": "ent_sector", "role": "grouping", "required": true },
            { "entityId": "ent_age_group", "role": "filter", "required": false, "defaultMember": "15+" },
            { "entityId": "ent_period", "role": "time", "required": true, "periodRole": "current" }
          ],
          "analyticsSpec": {
            "operation": "group_aggregate",
            "measure": { "entityRef": "ent_wpr", "agg": "weighted_ratio" },
            "groupBy": [{ "entityRef": "ent_sector" }],
            "filters": [{ "entityRef": "ent_age_group", "op": "eq", "valueFrom": "defaultMember" }],
            "sort": { "by": "measure", "order": "desc" },
            "topN": null,
            "compare": { "kind": "across_group", "baseline": null }
          },
          "answerStructure": {
            "components": [
              {
                "componentId": "q_wpr_01_c1",
                "kind": "narrative",
                "order": 1,
                "outputContract": { "type": "prose", "minWords": 40, "maxWords": 90 },
                "narrativeTemplate": {
                  "tone": "formal-analytical",
                  "mustMention": ["ent_wpr", "ent_sector"],
                  "pattern": "headline_then_gap",
                  "maxWords": 90
                },
                "refs": { "contentRef": "p_wpr_intro", "analyticsRef": "", "evidenceRef": "" }
              },
              {
                "componentId": "q_wpr_01_c2",
                "kind": "chart",
                "order": 2,
                "outputContract": { "type": "chart", "chartType": "grouped_bar", "xAxis": "ent_sector", "yAxis": "ent_wpr" },
                "refs": { "chartRef": "chart_wpr_sector", "figureRef": "fig_wpr_01", "analyticsRef": "", "evidenceRef": "" }
              },
              {
                "componentId": "q_wpr_01_c3",
                "kind": "table",
                "order": 3,
                "outputContract": { "type": "table", "tableTemplateRef": "tt_wpr_state" },
                "refs": { "tableRef": "table_wpr_state", "analyticsRef": "", "evidenceRef": "" }
              }
            ]
          }
        },
        {
          "questionId": "q_wpr_02",
          "intent": "Rank States/UTs by Worker Population Ratio for the current period.",
          "questionType": "ranking",
          "priority": 2,
          "requiredEntities": [
            { "entityId": "ent_wpr", "role": "measure", "required": true },
            { "entityId": "ent_state", "role": "grouping", "required": true },
            { "entityId": "ent_period", "role": "time", "required": true, "periodRole": "current" }
          ],
          "analyticsSpec": {
            "operation": "rank",
            "measure": { "entityRef": "ent_wpr", "agg": "weighted_ratio" },
            "groupBy": [{ "entityRef": "ent_state" }],
            "filters": [],
            "sort": { "by": "measure", "order": "desc" },
            "topN": 10,
            "compare": { "kind": "none" }
          },
          "answerStructure": {
            "components": [
              {
                "componentId": "q_wpr_02_c1",
                "kind": "table",
                "order": 1,
                "outputContract": { "type": "table", "tableTemplateRef": "tt_wpr_state" },
                "refs": { "tableRef": "table_wpr_state", "analyticsRef": "", "evidenceRef": "" }
              }
            ]
          }
        }
      ]
    }
  ],
  "tableTemplates": [
    {
      "tableTemplateId": "tt_wpr_state",
      "title": "Worker Population Ratio by State/UT and Sector",
      "columnGroups": [
        { "groupId": "grp_rural", "label": "Rural", "spanRefs": ["col_rural_person"] },
        { "groupId": "grp_urban", "label": "Urban", "spanRefs": ["col_urban_person"] }
      ],
      "columns": [
        { "columnId": "col_state", "header": "State/UT", "role": "dimension", "entityRef": "ent_state", "dtype": "string", "align": "left", "format": null },
        { "columnId": "col_rural_person", "header": "Rural", "role": "measure", "entityRef": "ent_wpr", "group": "grp_rural", "filterContext": { "ent_sector": "Rural" }, "dtype": "number", "unit": "percent", "format": "percent.1", "align": "right" },
        { "columnId": "col_urban_person", "header": "Urban", "role": "measure", "entityRef": "ent_wpr", "group": "grp_urban", "filterContext": { "ent_sector": "Urban" }, "dtype": "number", "unit": "percent", "format": "percent.1", "align": "right" }
      ],
      "dimensions": ["ent_state"],
      "measures": ["ent_wpr"],
      "breakdowns": ["ent_sector"],
      "footnotes": [
        { "noteId": "fn_source", "marker": "Source", "textTemplate": "Source: {{dataset.title}}, {{period.current}}." },
        { "noteId": "fn_wpr", "marker": "Note", "textTemplate": "WPR computed on usual status (ps+ss) for persons aged {{filter.age_group}}." }
      ],
      "sort": { "by": "col_rural_person", "order": "desc" },
      "emptyPolicy": "show_dash"
    }
  ],
  "figureTemplates": [
    {
      "figureTemplateId": "ft_wpr_01",
      "captionTemplate": "Worker Population Ratio by Sector, {{period.current}}",
      "chartId": "chart_wpr_sector",
      "numbering": "Figure {{topic.order}}.{{seq}}"
    }
  ],
  "documentMap": {
