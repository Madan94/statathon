    {
      "entityId": "ent_period",
      "canonicalName": "Survey Period",
      "entityType": "time",
      "aliases": ["Year", "Survey period", "round", "PLFS round"],
      "valueDomain": { "kind": "temporal", "granularity": "annual", "format": "YYYY-YY" },
      "scope": "time",
      "confidence": null
    }
