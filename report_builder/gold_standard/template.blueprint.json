{
  "$schema": "bharatstat/template-blueprint/v1",
  "_doc": "VALUE-FREE + PROSE-FREE analytic brain. Defines WHAT to compute and HOW to render. Contains NO numbers, NO sentences, NO dataset. Pairs 1:1 with template.ast.json by shared IDs.",
  "templateMeta": {
    "templateId": "tpl_plfs_annual_v1",
    "name": "PLFS Annual Report \u2014 Employment Indicators",
    "domain": "labour_force",
    "locale": "en-IN",
    "version": "1.0.0",
    "sourceDocument": "Periodic Labour Force Survey \u2014 Annual Report",
    "valueFree": true,
    "proseFree": true,
    "description": "Skeleton blueprint extracted from a reference PDF. Reusable across datasets and survey rounds."
  },
  "glossary": {
    "WPR": "Worker Population Ratio \u2014 percentage of employed persons in the population.",
    "LFPR": "Labour Force Participation Rate \u2014 percentage of the population in the labour force (working or seeking work).",
    "UR": "Unemployment Rate \u2014 percentage of the labour force that is unemployed.",
    "usual_status": "Activity status over the 365 days preceding the survey (principal + subsidiary, ps+ss).",
    "sector": "Rural or Urban classification of the household."
  },
  "palette": {
    "paletteId": "pal_mospi_default",
    "sequential": ["#0B5394", "#3D85C6", "#6FA8DC", "#9FC5E8", "#CFE2F3"],
    "categorical": {
      "Rural": "#1F7A1F",
      "Urban": "#0B5394",
      "Male": "#0B5394",
      "Female": "#CC4125",
      "Total": "#666666"
    },
    "semantic": { "positive": "#1F7A1F", "negative": "#CC0000", "neutral": "#666666" }
  },
  "renderProfile": {
    "numberFormat": { "locale": "en-IN", "grouping": "lakh-crore", "decimalSeparator": "." },
    "percentFormat": { "decimals": 1, "suffix": "%" },
    "currencyFormat": { "symbol": "\u20b9", "grouping": "lakh-crore", "decimals": 0 },
    "fontFamily": "Noto Sans",
    "pageSize": "A4"
  },
  "entities": [
