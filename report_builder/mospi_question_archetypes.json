        "layout": "multi-panel",
        "components": ["narrative_paragraph", "data_table", "line_chart"]
      },
      {
        "template": "What is the share of {dimension} in total household expenditure?",
        "questionType": "composition",
        "layout": "split",
        "components": ["narrative_paragraph", "pie_chart", "data_table"]
      }
    ]
  },

