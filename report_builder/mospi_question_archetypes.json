{
  "_comment": "MoSPI question archetype library. Each domain has trigger_entities (substring match) and archetypes with template slots.",

  "labour_force": {
    "trigger_entities": ["lfpr", "wpr", "ur", "labour force", "worker population", "unemployment"],
    "archetypes": [
      {
        "template": "How does {measure} vary across States and Union Territories by {breakdown}?",
        "questionType": "comparison",
        "layout": "state_comparison",
        "components": ["narrative_paragraph", "data_table", "grouped_bar_chart"]
      },
      {
        "template": "What is the trend in {measure} ({gender}) across survey rounds?",
        "questionType": "trend",
        "layout": "trend_analysis",
        "components": ["narrative_paragraph", "line_chart", "data_table"]
      },
      {
        "template": "Compare {measure} for Rural and Urban population across States",
        "questionType": "comparison",
        "layout": "split",
        "components": ["narrative_paragraph", "grouped_bar_chart"]
      },
      {
        "template": "Which States have the highest and lowest {measure} for {breakdown}?",
        "questionType": "ranking",
        "layout": "state_comparison",
        "components": ["narrative_paragraph", "data_table", "grouped_bar_chart"]
      },
      {
        "template": "What is the distribution of workers by {dimension} in {sector} areas?",
        "questionType": "distribution",
        "layout": "split",
        "components": ["narrative_paragraph", "pie_chart", "data_table"]
      }
    ]
  },

  "consumption": {
    "trigger_entities": ["mpce", "consumption", "monthly per capita", "household expenditure", "expenditure"],
