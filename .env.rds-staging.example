# RDS Mumbai staging profile — copy values into .env when using a shared cloud DB.
# Requires an active SSM port-forward tunnel (scripts/aws/rds_ssm_tunnel.ps1).
# Keep local Postgres for daily dev; use this only for team demos / staging.

DATABASE_URL=postgresql://statathon:CHANGE_ME@127.0.0.1:5433/statathon?sslmode=require

DB_NULL_POOL=false
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=280
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO_POOL=false

# SSM tunnel settings (used by rds_ssm_tunnel.ps1 — not read by the app)
RDS_SSM_BASTION_INSTANCE_ID=i-0123456789abcdef0
RDS_SSM_REMOTE_HOST=statathon.xxxxx.ap-south-1.rds.amazonaws.com
RDS_SSM_LOCAL_PORT=5433
RDS_SSM_REMOTE_PORT=5432
AWS_REGION=ap-south-1
